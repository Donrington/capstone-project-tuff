# Copy to .env and fill in. Never commit .env — the repo root .gitignore
# already excludes it.

PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (or a local mongod instance).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/tuff?retryWrites=true&w=majority

# Long random strings — e.g. `openssl rand -hex 32`. Different values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Must match the frontend's dev origin so cookies/CORS work.
FRONTEND_ORIGIN=http://localhost:3000
