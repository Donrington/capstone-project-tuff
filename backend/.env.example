# Copy to .env and fill in. Never commit .env.

PORT=4000

# MongoDB Atlas connection string (or a local mongod instance). Named to
# match config/dbConfig.js, which reads process.env.MONGO_URI.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/tuff?retryWrites=true&w=majority

# Must match the frontend's dev origin, so cookies/CORS work.
FRONTEND_ORIGIN=http://localhost:3000

# Long random strings, different values — e.g. `openssl rand -hex 32` (or
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Only used to sign/verify the short-lived access token; the refresh token
# is a random string stored (hashed) in the RefreshToken collection, not a
# JWT, so it doesn't need its own secret.
JWT_ACCESS_SECRET=

# Cloudinary, for profile photos (utils/cloudinary.js). Optional: without
# all three the API still runs and only PUT /api/users/me/photo answers 503.
# Find them under Cloudinary Console > Settings > API Keys. The secret is
# server-only: never put it in the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google sign-in (POST /api/auth/google). Optional: without both, that
# endpoint answers 503 and the frontend says Google isn't set up yet. See
# "Setting up Google sign-in" in README.md. The secret is server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude (services/aiService.js). Optional, and every feature that uses it
# degrades without breaking: the rival banter line just doesn't appear,
# describing an activity in words answers 503 (the number field still
# works), and the admin flags list shows flagged entries with no AI note.
# console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=
