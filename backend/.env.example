# Copy to .env and fill in. Never commit .env.

PORT=4000

# MongoDB Atlas connection string (or a local mongod instance). Named to
# match config/dbConfig.js, which reads process.env.MONGO_URI.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/tuff?retryWrites=true&w=majority

# Must match the frontend's dev origin, so cookies/CORS work.
FRONTEND_ORIGIN=http://localhost:3000
