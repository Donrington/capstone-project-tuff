# Copy to .env.local. Both are optional.

# Where the Express backend runs (server-side only; the browser never calls it).
API_URL=http://localhost:4000

# "api" (default) uses the real backend. "mock" uses the in-memory demo data,
# with no backend needed; the e2e tests run this way.
TUFF_DATA_SOURCE=api

# Google sign-in: the OAuth client ID (server-side only). The same value goes
# in the backend's GOOGLE_CLIENT_ID; the secret lives only on the backend.
# Without it, "Continue with Google" explains it isn't set up yet.
GOOGLE_CLIENT_ID=

# The public origin, for link previews, the sitemap and canonical links.
# Optional: on Vercel it falls back to the project's production hostname.
# Set it once there is a custom domain, e.g. https://tuff.example
# NEXT_PUBLIC_SITE_URL=
